{
  "name": "@nexus/etl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pipelines d'ingestion du cadastre Etalab et du COG INSEE. Node + TS vanilla, sans framework : un run est une suite d'étapes idempotentes qui écrivent Postgres.",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "pg": "8.19.0",
    "pg-copy-streams": "7.0.0",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0"
  },
  "devDependencies": {
    "@nexus/eslint-config": "workspace:*",
    "@nexus/typescript-config": "workspace:*",
    "@types/node": "22.18.10",
    "@types/pg": "8.20.0",
    "@types/pg-copy-streams": "1.2.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
