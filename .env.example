# =============================================================================
# nexus-analytics — configuration locale
# Copier en .env et ajuster. Le .env n'est jamais commité.
# =============================================================================

# --- Postgres ----------------------------------------------------------------
# 5432 = Postgres natif de l'hôte, 5433 = todoride-database-dev. On prend 5434.
DB_HOST_PORT=5434
DB_HOST=localhost
DB_PORT=5434
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=nexus_dev

# Mémoire allouée au container Postgres.
# 4g par défaut (machine partagée). Passer à 12g+ pour un run parcelles quand
# les autres stacks Docker sont arrêtées — et penser à relever shared_buffers
# dans infra/docker/postgresql.conf en conséquence (~25% de cette valeur).
DB_MEM_LIMIT=4g

# --- Stockage ----------------------------------------------------------------
# Le volume Postgres. Prévoir large : ~500 Go pour les parcelles sur 36 millésimes.
DB_DATA_DIR=/home/bbw/data/nexus-cadastre/pgdata
# Cache des fichiers téléchargés (.json.gz du cadastre) + zone de travail partagée
# avec le container (montée sur /work côté serveur).
DATA_DIR=/home/bbw/data/nexus-cadastre/work

# --- Adminer -----------------------------------------------------------------
# 8180 est pris par cvc-adminer-dev.
ADMINER_HOST_PORT=8181
